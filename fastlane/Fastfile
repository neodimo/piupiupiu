default_platform(:ios)

platform :ios do
  desc "Build the Godot-exported Xcode project and ship to TestFlight"
  lane :beta do
    key_id = ENV["ASC_KEY_ID"]
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    # Apple cloud-managed signing: no local cert wrangling, no 2-cert limit,
    # no Mac. xcodebuild uses the API key to create/reuse a managed
    # distribution cert + App Store profile on the fly (-allowProvisioningUpdates).
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"

    build_app(
      project: "build/ios/piupiupiu.xcodeproj",
      scheme: "piupiupiu",
      export_method: "app-store",
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Automatic",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"]
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
